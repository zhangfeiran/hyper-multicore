+template <bool TransposeX>
+__aicore__ inline void ApplyDynamicRows(GMMBaseParams &base, TCubeTiling &tile, int64_t rows, bool singleGroup)
+{
+    // Each invocation already has a private tiling copy. Keep the shared image immutable.
+    if (rows == 0) return;
+    if constexpr (TransposeX) {
+        tile.Ka = rows;
+        tile.Kb = rows;
+        tile.singleCoreK = rows;
+    } else {
+        base.m = rows;
+        tile.M = rows;
+        tile.singleCoreM = rows;
+    }
+    if (singleGroup) base.groupNum = 1;
+}
